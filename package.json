{
  "name": "jupol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dashboard:dev",
    "scan": "node --experimental-strip-types apps/scanner/src/cli.ts",
    "book": "node --experimental-strip-types apps/scanner/src/book-cli.ts",
    "monitor:btc-aug21": "node --experimental-strip-types apps/scanner/src/btc-aug21-monitor.ts",
    "monitor:short-window": "node --experimental-strip-types apps/scanner/src/btc-short-window-monitor.ts",
    "monitor:short-window:any-route": "node --experimental-strip-types apps/scanner/src/btc-short-window-monitor.ts --any-complementary-route --output=logs/btc-poly-jup-short-window-any-route.jsonl",
    "bot:short-window": "node --experimental-strip-types --env-file-if-exists=.env apps/scanner/src/btc-short-window-monitor.ts --live-trade --max-reference-difference-usd=30",
    "bot:short-window:live": "node --experimental-strip-types --env-file-if-exists=.env apps/scanner/src/btc-short-window-monitor.ts --live-trade --max-reference-difference-usd=30",
    "bot:short-window:any-route": "node --experimental-strip-types --env-file-if-exists=.env apps/scanner/src/btc-short-window-monitor.ts --live-trade --any-complementary-route --max-reference-difference-usd=30 --output=logs/btc-poly-jup-short-window-any-route.jsonl",
    "check:live:readiness": "node --experimental-strip-types --env-file-if-exists=.env apps/scanner/src/btc-short-window-monitor.ts --live-trade --check-live-readiness",
    "check:polymarket:live": "node --experimental-strip-types --env-file-if-exists=.env apps/scanner/src/btc-short-window-monitor.ts --live-trade --check-polymarket-readiness",
    "setup:polymarket:live": "node --experimental-strip-types --env-file-if-exists=.env apps/scanner/src/btc-short-window-monitor.ts --live-trade --setup-trading-approvals",
    "dashboard:dev": "npm --prefix apps/dashboard run dev",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "rust:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "rust:test": "cargo test --workspace",
    "rust:bench:domain": "cargo run --release -p jupol-domain --example domain_bench",
    "test": "node --experimental-strip-types --test packages/*/test/*.test.ts apps/scanner/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@polymarket/client": "0.6.0",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "viem": "^2.55.19"
  }
}
