{
  "name": "jupol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dashboard:dev",
    "scan": "node --experimental-strip-types apps/scanner/src/cli.ts",
    "book": "node --experimental-strip-types apps/scanner/src/book-cli.ts",
    "monitor:btc-aug21": "node --experimental-strip-types apps/scanner/src/btc-aug21-monitor.ts",
    "monitor:short-window": "cargo run --release -p jupol-scanner -- monitor",
    "monitor:short-window:any-route": "cargo run --release -p jupol-scanner -- monitor --output=logs/btc-poly-jup-short-window-any-route.jsonl",
    "bot:short-window": "cargo run --release -p jupol-scanner -- live",
    "bot:short-window:live": "cargo run --release -p jupol-scanner -- live",
    "bot:short-window:any-route": "cargo run --release -p jupol-scanner -- live --output=logs/btc-poly-jup-short-window-any-route.jsonl",
    "check:live:readiness": "cargo run --release -p jupol-scanner -- readiness",
    "check:polymarket:live": "cargo run --release -p jupol-scanner -- readiness --polymarket-only",
    "check:polymarket:access": "cargo run --release -p jupol-scanner -- check-polymarket-access",
    "setup:polymarket:live": "cargo run --release -p jupol-scanner -- setup-approvals",
    "recover:live": "cargo run --release -p jupol-scanner -- recover",
    "redeem:polymarket": "cargo run --release -p jupol-scanner -- redeem",
    "state:live": "cargo run --release -p jupol-scanner -- state",
    "dashboard:dev": "npm --prefix apps/dashboard run dev",
    "dashboard:build": "npm --prefix apps/dashboard run build",
    "rust:check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "rust:build": "cargo build --release -p jupol-scanner",
    "rust:test": "cargo test --workspace",
    "rust:bench:domain": "cargo run --release -p jupol-domain --example domain_bench",
    "test": "node --experimental-strip-types --test packages/*/test/*.test.ts apps/scanner/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run rust:check"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@polymarket/client": "0.6.0",
    "@solana/web3.js": "1.98.4",
    "bs58": "6.0.0",
    "viem": "^2.55.19"
  }
}
