# Required by Jupiter Prediction discovery. A Developer plan permits 10 RPS,
# but the key must also have Prediction and Swap product access in the portal.
JUPITER_API_KEY=

# Required only for explicit real-money mode. Never commit real values.
# Solana accepts a base58 secret key or a JSON byte array. Use a dedicated low-balance wallet.
JUPITER_SOLANA_PRIVATE_KEY=
SOLANA_RPC_URL=

# Polygon signer key plus the Polymarket funder/deposit-wallet address it controls.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
# eoa, proxy, gnosis_safe, or poly1271. Do not guess the wallet type.
POLYMARKET_SIGNATURE_TYPE=poly1271
# Gasless wallet operations (approvals and resolution redemption).
# Create these in Polymarket Settings > API Keys. The address is the key owner shown there.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=

# Live mode refuses to start unless this exact phrase is supplied.
LIVE_TRADING_CONFIRMATION=

# Read-only endpoint overrides for controlled testing.
JUPITER_PREDICTION_URL=https://api.jup.ag/prediction/v1
JUPITER_SWAP_URL=https://api.jup.ag/swap/v2
JUPITER_PREDICTION_PRICE_WEBSOCKET_URL=wss://prediction-market-price-service.fly.dev/ws/prices
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
